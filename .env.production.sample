# Production environment configuration
# Generate one strong secret and reuse it for the legacy keys if your deployment relies on them.
AUTH_SECRET=`openssl rand -hex 32` or go to https://generate-secret.now.sh/32
NEXTAUTH_SECRET=`openssl rand -hex 32` or go to https://generate-secret.now.sh/32
NEXT_AUTH_SECRET=`openssl rand -hex 32` or go to https://generate-secret.now.sh/32

# Update with your production domain (must match the redirect URIs configured with providers)
NEXTAUTH_URL=https://your-production-domain.com


# OAuth provider credentials for production
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_TRUST_HOST=true

# PostgreSQL 连接配置
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_DB=

# 完整连接字符串（Prisma、TypeORM、Drizzle 都能用）
POSTGRES_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
DATABASE_URL=${POSTGRES_URL}
POSTGRES_SSL=false
POSTGRES_SSL_REJECT_UNAUTHORIZED=false
POSTGRES_CONNECTION_TIMEOUT=5000
POSTGRES_IDLE_TIMEOUT=10000
