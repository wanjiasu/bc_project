NEXTAUTH_SECRET=`openssl rand -hex 32` or go to https://generate-secret.now.sh/32
NEXT_AUTH_SECRET=`openssl rand -hex 32` or go to https://generate-secret.now.sh/32

# Local development URL
NEXTAUTH_URL=http://localhost:3000/

